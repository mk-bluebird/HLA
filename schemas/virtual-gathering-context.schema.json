{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthline.example/schemas/virtual-gathering-context.schema.json",
  "title": "Hearthline Virtual Gathering Context",
  "description": "A bounded, optional social-interaction context with explicit access, consent, reporting, and retention controls. It is not a trust certification, safety rating, reputation object, attendance record, or identity-verification requirement.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contextId",
    "state",
    "purpose",
    "participationScope",
    "interactionFormats",
    "interactionRules",
    "accessOptions",
    "consentCheckpoints",
    "safetyControls",
    "retentionPolicy",
    "createdAt",
    "expiresAt",
    "policyVersion"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "contextId": {
      "type": "string",
      "pattern": "^virtual_context_[A-Za-z0-9_-]{16,128}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused_by_owner",
        "closed_by_owner",
        "expired",
        "removed_by_policy"
      ]
    },
    "purpose": {
      "type": "string",
      "enum": [
        "conversation",
        "shared_activity",
        "board_game",
        "learning",
        "creative_collaboration",
        "public_event_discussion",
        "remote_workshop"
      ]
    },
    "participationScope": {
      "type": "string",
      "enum": [
        "invitation_only",
        "reciprocal_interest_only",
        "bounded_group",
        "member_selected_visibility"
      ]
    },
    "interactionFormats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "text",
          "asynchronous_board",
          "captioned_voice_optional",
          "captioned_video_optional",
          "shared_activity_canvas"
        ]
      }
    },
    "interactionRules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "ask_before_sexual_topics",
          "no_recording_without_separate_permission",
          "no_pressure_for_contact_details",
          "no_money_or_material_exchange",
          "respect_leave_without_explanation",
          "no_unwanted_media",
          "public_activity_scope_only",
          "no_identity_disclosure_required"
        ]
      }
    },
    "accessOptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "text_first",
          "keyboard_supported",
          "screen_reader_supported",
          "captions_available",
          "reduced_motion_supported",
          "low_bandwidth_path",
          "no_camera_required",
          "no_microphone_required",
          "no_voice_required",
          "asynchronous_option"
        ]
      }
    },
    "consentCheckpoints": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "voice",
          "video",
          "media",
          "sexual_topics",
          "recording",
          "named_public_venue",
          "meeting_plan",
          "ar_camera",
          "ar_microphone",
          "ar_spatial_mapping"
        ]
      }
    },
    "safetyControls": {
      "type": "array",
      "minItems": 4,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "leave",
          "mute",
          "block",
          "report",
          "human_review_request",
          "appeal_information",
          "privacy_settings"
        ]
      }
    },
    "retentionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rosterRetention",
        "messageRetention",
        "auditRetentionClass"
      ],
      "properties": {
        "rosterRetention": {
          "type": "string",
          "const": "no_persistent_roster"
        },
        "messageRetention": {
          "type": "string",
          "enum": [
            "member_controlled",
            "ephemeral_context",
            "not_available"
          ]
        },
        "auditRetentionClass": {
          "type": "string",
          "const": "content_minimized_purpose_limited"
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^virtual-gathering-policy-v[0-9]+$"
    }
  },
  "$comment": "Forbidden fields include trusted, verifiedSafe, safetyScore, trustScore, riskScore, popularityScore, communityRating, participantRoster, attendanceHistory, memberLocation, preciseVenueLocation, proximity, identity-group suitability, host reputation, counterpart activity, presence state, live user count, private messages, protected identity, and person-level ranking."
}
