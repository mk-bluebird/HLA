{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthline.example/schemas/non-stigma-connection-design-review.schema.json",
  "title": "Hearthline Non-Stigma Connection Design Review",
  "description": "A feature-level governance review for consent, privacy, accessibility, non-commercial integrity, anti-stigma language, and appealability. It is not a score of people, communities, venues, identities, relationship styles, or casual encounters.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewId",
    "featureRef",
    "featureVersion",
    "reviewDimensions",
    "outcome",
    "reviewedAt",
    "reviewers",
    "policyVersion"
  ],
  "properties": {
    "reviewId": {
      "type": "string",
      "pattern": "^nonstigma_review_[A-Za-z0-9_-]{16,128}$"
    },
    "featureRef": {
      "type": "string",
      "pattern": "^feature_[A-Za-z0-9_-]{16,128}$"
    },
    "featureVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "reviewDimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "neutral_language",
          "intent_not_consent",
          "capability_scoped_consent",
          "withdrawal_and_exit",
          "noncommercial_integrity",
          "privacy_minimization",
          "no_identity_inference",
          "no_location_surveillance",
          "accessibility_parity",
          "reporting_and_human_review",
          "correction_and_appeal",
          "allowed_field_boundary",
          "forbidden_field_boundary",
          "no_person_scoring",
          "no_dark_patterns",
          "policy_legal_clarity"
        ]
      }
    },
    "outcome": {
      "type": "string",
      "enum": [
        "approved_with_safeguards",
        "requires_remediation",
        "blocked_from_release",
        "requires_policy_or_legal_review"
      ]
    },
    "findingCodes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_\\-]+$"
      }
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "privacy",
          "accessibility",
          "safety",
          "policy",
          "engineering",
          "member_research",
          "legal_review",
          "independent_audit"
        ]
      }
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^nonstigma-connection-policy-v[0-9]+$"
    }
  },
  "$comment": "Forbidden fields include personRef, communityRef, venueRef, identity group, protected class, social graph, member behavior, relationship history, sexual activity, report count, safety score, risk score, trust score, reputation score, acceptance score, influence score, popularity score, compatibility score, or network analysis result."
}
