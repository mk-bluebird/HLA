{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthline.example/schemas/optional-minimal-claim-credential-presentation.schema.json",
  "title": "Hearthline Optional Minimal-Claim Credential Presentation",
  "description": "A member-initiated presentation of a narrow, current claim. It is not a general identity verification record, public credential, reputation credential, or trust/safety certificate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "presentationId",
    "holderRef",
    "claimType",
    "purpose",
    "state",
    "issuedAt",
    "expiresAt",
    "memberInitiated",
    "revocable"
  ],
  "properties": {
    "presentationId": {
      "type": "string",
      "pattern": "^credential_presentation_[A-Za-z0-9_-]{16,128}$"
    },
    "holderRef": {
      "type": "string",
      "pattern": "^member_[A-Za-z0-9_-]{16,128}$"
    },
    "claimType": {
      "type": "string",
      "enum": [
        "adult_membership_eligibility_current",
        "scoped_consent_grant_current",
        "reciprocal_interest_window_current",
        "public_first_meeting_plan_mutually_accepted",
        "named_public_venue_envelope_current"
      ]
    },
    "purpose": {
      "type": "string",
      "enum": [
        "adult_policy",
        "conversation",
        "meeting_planning",
        "venue_disclosure",
        "consent_scope"
      ]
    },
    "recipientRef": {
      "type": "string",
      "pattern": "^(member|verifier|service)_[A-Za-z0-9_-]{16,128}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "withdrawn",
        "expired",
        "rejected"
      ]
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "memberInitiated": {
      "type": "boolean",
      "const": true
    },
    "revocable": {
      "type": "boolean",
      "const": true
    },
    "proofRef": {
      "type": "string",
      "pattern": "^proof_[A-Za-z0-9_-]{16,128}$"
    }
  },
  "$comment": "Forbidden fields include legalName, dateOfBirth, exactAge, address, governmentId, documentImage, issuerMetadata, credentialSubjectId, publicDid, walletAddress, biometric, identityConfidence, verifiedIdentityScore, safetyScore, trustScore, reputationScore, riskScore, compatibilityScore, desirabilityScore, reportHistory, blockHistory, sexualHistory, health, recovery, finances, housing, employment, or protected identity."
}
