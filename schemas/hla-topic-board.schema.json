{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthline.example/schemas/hla-topic-board.schema.json",
  "title": "Hearthline Topic Board",
  "description": "A participant-controlled board for optional reviewed conversation topics. Topic visibility is distinct from activation. A visible topic creates no response obligation and does not authorize another capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "boardId",
    "participantRefs",
    "state",
    "topics",
    "createdAt",
    "updatedAt",
    "retentionClass"
  ],
  "properties": {
    "boardId": {
      "type": "string",
      "pattern": "^topic_board_[A-Za-z0-9_-]{16,128}$"
    },
    "participantRefs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^member_[A-Za-z0-9_-]{16,128}$"
      }
    },
    "state": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "closed",
        "deleted"
      ]
    },
    "topics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "retentionClass": {
      "type": "string",
      "const": "member_controlled_topic_context"
    }
  },
  "$defs": {
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topicId",
        "source",
        "text",
        "state",
        "activationMode",
        "createdAt"
      ],
      "properties": {
        "topicId": {
          "type": "string",
          "pattern": "^topic_[A-Za-z0-9_-]{16,128}$"
        },
        "source": {
          "type": "string",
          "enum": [
            "reviewed_prompt_library",
            "member_proposed",
            "member_selected_shared_activity_context",
            "member_selected_public_source_category",
            "member_selected_pace_or_boundary_context"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "state": {
          "type": "string",
          "enum": [
            "proposed_to_participants",
            "visible_for_review",
            "active_for_opted_in_participants",
            "paused",
            "closed",
            "deleted"
          ]
        },
        "activationMode": {
          "type": "string",
          "enum": [
            "all_participants",
            "group_threshold"
          ]
        },
        "groupThreshold": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "optedInParticipantRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^member_[A-Za-z0-9_-]{16,128}$"
          }
        },
        "hiddenParticipantRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^member_[A-Za-z0-9_-]{16,128}$"
          }
        },
        "blockedParticipantRefs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^member_[A-Za-z0-9_-]{16,128}$"
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "activationMode": {
                "const": "group_threshold"
              }
            },
            "required": [
              "activationMode"
            ]
          },
          "then": {
            "required": [
              "groupThreshold"
            ]
          }
        }
      ]
    }
  },
  "$comment": "Forbidden fields include topic score, popularity, engagement count, response rate, private-message extraction, identity inference, accessibility inference, location, attendance, behavior profile, safety score, risk score, trust score, compatibility score, or person-level social value."
}
