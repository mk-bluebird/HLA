{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hearthline.example/schemas/optional-discovery-preference.schema.json",
  "title": "Hearthline Optional Discovery Preference",
  "description": "A member-controlled preference for organizing their own discovery experience. It does not require self-labeling, classify the member, authorize contact, or create a person-level ranking.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preferenceId",
    "ownerRef",
    "state",
    "preferenceType",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "preferenceId": {
      "type": "string",
      "pattern": "^discovery_pref_[A-Za-z0-9_-]{16,128}$"
    },
    "ownerRef": {
      "type": "string",
      "pattern": "^member_[A-Za-z0-9_-]{16,128}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "active",
        "paused_by_owner",
        "withdrawn",
        "expired"
      ]
    },
    "preferenceType": {
      "type": "string",
      "enum": [
        "connection_intent",
        "activity_context",
        "communication_pace",
        "meeting_preference",
        "optional_self_description_visibility"
      ]
    },
    "selectedValues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 96
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$comment": "The preference must not contain required own-identity labels, protected-identity inference, a counterpart score, rank, exclusion list based on protected traits, safety/trust/risk/desirability evaluation, exact location, availability history, social graph, or behavioral data."
}
